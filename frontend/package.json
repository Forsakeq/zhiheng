{
  "name": "zhiheng-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "知衡健康生活助手 · Vue 3 手机 App",
  "scripts": {
    "dev": "uni --host 0.0.0.0 --port 5173",
    "dev:h5": "uni --host 0.0.0.0 --port 5173",
    "dev:app": "uni -p app",
    "build": "uni build",
    "build:h5": "uni build",
    "build:app": "uni build -p app",
    "build:app-harmony": "uni build -p app-harmony",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src vite.config.ts package.json tsconfig.json index.html README.md",
    "format:check": "prettier --check src vite.config.ts package.json tsconfig.json index.html README.md"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-app-harmony": "3.0.0-5020420260813003",
    "@dcloudio/uni-app-plus": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "vue": "3.4.21",
    "vue-i18n": "9.14.5"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/uni-stacktracey": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@types/node": "22.10.10",
    "@vue/runtime-core": "3.4.21",
    "prettier": "3.5.3",
    "sass": "1.77.8",
    "typescript": "4.9.5",
    "vite": "5.2.8",
    "vitest": "1.6.1",
    "vue-tsc": "1.8.27"
  }
}
